# Cấu hình frontend. Copy thành .env (dev) hoặc .env.production (build thật).
#   cp .env.example .env
#
# QUAN TRỌNG: biến VITE_* được NHÚNG VÀO BUNDLE lúc `npm run build`, không đọc được lúc
# chạy. Trên Cloudflare Workers/Pages, Vercel, Netlify... phải khai ở phần biến môi
# trường của BUILD; đổi URL backend thì phải build + deploy lại.

# ---- Dev ----
# Để TRỐNG ở dev: app tự suy ra "cùng host đang mở, cổng 8000" nên mở bằng localhost hay
# bằng IP LAN (điện thoại cùng Wi-Fi) đều chạy mà không phải sửa gì.
VITE_API_BASE_URL=

# ---- Production (FE và BE deploy riêng) ----
# Bắt buộc. Phải là HTTPS: trang https gọi http sẽ bị trình duyệt chặn (mixed content).
# Không có dấu "/" ở cuối. URL này phải nằm trong CORS_ORIGINS của backend.
# VITE_API_BASE_URL=https://api.vocabforge.example.com
