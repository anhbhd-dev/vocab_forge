# Cấu hình cho docker-compose. Copy thành .env rồi điền key.
#   cp .env.example .env

# ---- PostgreSQL ----
POSTGRES_USER=vocabforge
POSTGRES_PASSWORD=vocabforge
POSTGRES_DB=vocabforge

# ---- Cổng mở ra host (đổi nếu bị trùng) ----
VF_DB_PORT=5432
VF_API_PORT=8000
VF_WEB_PORT=5173

# ---- Backend ----
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
DEBUG=true

# ---- LLM ----
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Build target: dev (auto-reload + HMR) hoặc base/prod ----
VF_BUILD_TARGET=dev
VF_FE_BUILD_TARGET=dev
