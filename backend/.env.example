# ---- App ----
APP_NAME="VocabForge Pro"
DEBUG=true
DATABASE_URL="sqlite+aiosqlite:///./vocabforge.db"

# ---- Auth (file 04 yêu cầu #7: JWT đơn giản email/password) ----
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=10080

# ---- LLM providers (file 00 mục 3) ----
# provider mặc định: deepseek | gemini | mock
LLM_PROVIDER="deepseek"
# provider dùng khi provider chính lỗi (để trống = không fallback)
LLM_FALLBACK_PROVIDER="gemini"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL="gemini-2.0-flash"

LLM_TIMEOUT_SECONDS=120
# số lần retry khi LLM trả JSON không khớp schema (file 04 yêu cầu #4)
LLM_SCHEMA_RETRIES=2

# ---- SRS ----
FSRS_DESIRED_RETENTION=0.9
FSRS_MAXIMUM_INTERVAL=36500
FSRS_ENABLE_FUZZING=true

# ---- Cluster agent pre-filter (file 03 mục Agent 3, ghi chú kỹ thuật) ----
CLUSTER_SIMILARITY_THRESHOLD=0.75
CLUSTER_MIN_NEW_SENSES=5

# ---- CORS: bắt buộc khi FE và BE deploy tách nhau ----
# Chính là origin trên thanh địa chỉ của frontend, KHÔNG có dấu "/" ở cuối.
# Nhận cả hai dạng: phân tách bằng dấu phẩy, hoặc JSON ["https://a","https://b"].
CORS_ORIGINS="https://vocab-forge.buihoangducanh0987.workers.dev"
# Regex cho domain preview sinh tự động (mỗi PR một subdomain). Để trống nếu không dùng.
CORS_ORIGIN_REGEX=""

# =====================================================================
# Khối dưới đây CHỈ dành cho bản deploy thật. Đặt DEBUG=false là backend
# tự kiểm tra JWT_SECRET lúc khởi động và từ chối chạy nếu còn giá trị mẫu.
# =====================================================================
# DEBUG=false
# JWT_SECRET sinh mới, tối thiểu 32 ký tự:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# PostgreSQL của nhà cung cấp. Lưu ý: driver PHẢI là postgresql+asyncpg://
# — chuỗi họ đưa thường bắt đầu bằng postgres:// hoặc postgresql://, phải sửa lại.
# DATABASE_URL="postgresql+asyncpg://user:pass@host:5432/dbname"
#
# Cổng: image tự đọc biến PORT nếu nền tảng có cấp (Railway/Render/Cloud Run).
#
# TTS: TTS_BASE_URL mặc định trỏ tới service "tts" trong mạng docker-compose. Deploy
# lẻ backend mà không dựng Kokoro thì phải tắt, nếu không mỗi lần sinh audio đều timeout.
# TTS_ENABLED=false
#
# Audio đã tổng hợp lưu trên đĩa. Nền tảng có filesystem tạm (Render free, Cloud Run,
# Fly không volume) sẽ xoá sạch sau mỗi lần restart → audio 404 dù DB vẫn ghi đường dẫn.
# Gắn volume bền vào đúng thư mục này, hoặc chấp nhận sinh lại.
# AUDIO_DIR=/app/audio
