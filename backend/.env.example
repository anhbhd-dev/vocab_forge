# ---- App ----
APP_NAME="VocabForge Pro"
DEBUG=true
DATABASE_URL="sqlite+aiosqlite:///./vocabforge.db"

# ---- Auth (file 04 yêu cầu #7: JWT đơn giản email/password) ----
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=10080

# ---- LLM providers (file 00 mục 3) ----
# provider mặc định: deepseek | gemini | mock
LLM_PROVIDER="deepseek"
# provider dùng khi provider chính lỗi (để trống = không fallback)
LLM_FALLBACK_PROVIDER="gemini"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL="gemini-2.0-flash"

LLM_TIMEOUT_SECONDS=120
# số lần retry khi LLM trả JSON không khớp schema (file 04 yêu cầu #4)
LLM_SCHEMA_RETRIES=2

# ---- SRS ----
FSRS_DESIRED_RETENTION=0.9
FSRS_MAXIMUM_INTERVAL=36500
FSRS_ENABLE_FUZZING=true

# ---- Cluster agent pre-filter (file 03 mục Agent 3, ghi chú kỹ thuật) ----
CLUSTER_SIMILARITY_THRESHOLD=0.75
CLUSTER_MIN_NEW_SENSES=5
